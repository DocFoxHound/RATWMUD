crates = crates | supply crates
barrel = barrel | supply barrel
bag = bag | grain bag
bags = bags | grain bags
flour = flour | sack flour
bread = bread | fresh bread
loaf = loaf | bread loaf
pork = pork | roast pork
crackling = crackling | browned crackling
