# cw150, the honest wrapper (Docs/Design/84). Exported from ridgemere3 at revision 1: edit it in Atlas or the DM, or as a draft through tools/mantle_load.py.
mantle cw150
revision 1
state ready
dialect coldwater
accent light broad
tier full
written_for tn_fh_wren_coldpeak
written_by claude-codex-cw-2
title the honest wrapper
fits stage=adult|old
prefers talk=chatty
traits temper=even talk=chatty warmth=warm humour=none honesty=plain piety=ordinary drive=steady
quirk reads_every_city_label_twice
likes smoked_eel stars market_bustle summer_evenings
dislikes waiting cold_tea
fears a_roof_falling_on_a_worker a_city_order_that_hides_its_cost
hopes every_worker_returns_from_the_shift honest_labels_on_every_bar
topics work +0.5 family +0.3 home +0.3 food +0.2 memories +0.3 gossip -0.3
styles comfort=warm gossip=careful refuse=plain tease=dry
marks oath saying
persona #self.first# checks every #wrapper# before a #bar# leaves the boiling house, asks where city #orders# came from, and watches the #stars# after work.

words
oath! = Wrapper and witness | By the sound roof
saying! = Read the wrapper before the promise | Count the workers coming home
soap = soap | firm soap
bar = bar | soap bar
bars = bars | soap bars
batch = batch | boiling batch
vat = vat | deep vat
vats = vats | boiling vats
lye = lye | strong lye
ash = ash | sifted ash
fat = fat | rendered fat
water = water | lake water
fire = fire | steady fire
heat = heat | even heat
paddle = paddle | stirring paddle
ladle = ladle | long ladle
mould = mould | soap mould
moulds = moulds | soap moulds
shelf = shelf | drying shelf
shelves = shelves | drying shelves
wrapper = wrapper | paper wrapper
wrappers = wrappers | paper wrappers
paper = paper | wrapping paper
page = page | order page
label = label | written label
mark = mark | batch mark
marks = marks | batch marks
order = order | written order
orders = orders | written orders
crate = crate | supply crate
crates = crates | supply crates
cart = cart | supply cart
road = road | High Road
city = city | Ridgemere
seller = seller | city seller
price = price | asking price
coin = coin | earned coin
coins = coins | earned coins
weight = weight | measured weight
buyers = buyers | careful buyers
plates = plates | supper plates
list = list | written list
work = work | day's work
worker = worker | boiling-house worker
workers = workers | work crew
hand = hand | working hand
hands = hands | working hands
floor = floor | boiling-house floor
door = door | workroom door
roof = roof | sound roof
gate = gate | yard gate
beam = beam | roof beam
mine = mine | deep mine
stone = stone | fallen stone
memory = memory | old memory
home = home | shared home
house = house | crowded house
spouse = spouse | partner
family = family | household
friend = friend | close friend
table = table | supper table
cup = cup | tea cup
tea = tea | hot tea
eel = eel | smoked eel
smoke = smoke | cooking smoke
plate = plate | supper plate
bread = bread | loaf
market = market | busy market
stall = stall | market stall
crowd = crowd | market crowd
stars = stars | night stars
star = star | bright star
sky = sky | clear sky
day = day | long day
night = night | late hour
summer = summer | warm season
