# lf103, the carved lark (Docs/Design/84). Exported from ridgemere3 at revision 2: edit it in Atlas or the DM, or as a draft through tools/mantle_load.py.
mantle lf103
revision 2
state ready
dialect larkfield
accent light broad
tier standard
written_for tn_oh_quill_oakdell
written_by claude-codex-lf-1
title the carved lark
fits stage=adult|old
prefers talk=plain
traits temper=even talk=plain warmth=warm humour=none honesty=guarded piety=ordinary drive=steady
quirk distrusts_anything_from_the_city
likes fried_fish evening_line full_larder thunder
dislikes gulls cold_tea
fears a_city_thread_that_breaks_in_the_loom an_empty_larder_after_a_bad_market
hopes a_full_shelf_before_winter a_carved_bird_for_every_friend
topics work +0.5 home +0.4 pastimes +0.3 prices +0.2
styles comfort=gentle gossip=reluctant refuse=plain tease=dry
marks oath saying
persona #self.first# tests the #thread# before weaving, carves a #bird# from spare #wood#, and counts #loaves# before the #storm#.

words
oath! = Shuttle and feather | By the true warp
saying! = Tug the thread before trusting its color | A little bird can cross any road
loom = loom | linen loom
shuttle = shuttle | wooden shuttle
warp = warp | taut warp
weft = weft | pale weft
thread = thread | linen thread
threads = threads | linen threads
linen = linen | woven linen
cloth = cloth | finished cloth
bolt = bolt | linen bolt
bolts = bolts | linen bolts
hem = hem | narrow hem
knot = knot | tight knot
knots = knots | tight knots
needle = needle | fine needle
beam = beam | loom beam
shed = shed | linen shed
work = work | loom work
hand = hand | working hand
hands = hands | working hands
wood = wood | scrap wood
knife = knife | carving knife
bird = bird | carved bird
birds = birds | small birds
wing = wing | thin wing
wings = wings | wooden wings
feather = feather | carved feather
lark = lark | field lark
gull = gull | loud gull
gulls = gulls | loud gulls
gift = gift | small gift
friend = friend | close friend
neighbour = neighbour | next-door neighbour
visitor = visitor | new visitor
seller = seller | market seller
buyer = buyer | careful buyer
merchant = merchant | city merchant
city = city | Ridgemere
market = market | Larkfield market
stall = stall | linen stall
road = road | High Road
gate = gate | town gate
toll = toll | gate toll
wagon = wagon | passing wagon
cart = cart | supply cart
price = price | asked price
coin = coin | saved coin
home = home | shared cottage
house = house | cottage house
table = table | supper table
shelf = shelf | larder shelf
larder = larder | full larder
loaf = loaf | fresh loaf
loaves = loaves | fresh loaves
bread = bread | fresh bread
fish = fish | fried fish
butter = butter | melted butter
pan = pan | frying pan
plate = plate | supper plate
tea = tea | warm tea
cup = cup | small cup
line = line | fishing line
water = water | pond water
bench = bench | plain bench
room = room | shared room
mornings = mornings | early mornings
box = box | sealed box
fields = fields | open fields
window = window | cottage window
pond = pond | field pond
field = field | open field
hill = hill | low hill
downs = downs | Larkdowns
evening = evening | late evening
morning = morning | early morning
storm = storm | thunderstorm
thunder = thunder | distant thunder
rain = rain | hard rain
roof = roof | sound roof
wind = wind | west wind
day = day | long day
hour = hour | quiet hour
