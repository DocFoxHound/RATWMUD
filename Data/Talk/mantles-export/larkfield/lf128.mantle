# lf128, the bogwise eel-trapping smith (Docs/Design/84). Exported from ridgemere3 at revision 2: edit it in Atlas or the DM, or as a draft through tools/mantle_load.py.
mantle lf128
revision 2
state ready
dialect larkfield
accent light broad
tier full
written_for tn_mb_tansy_eelbridge
written_by claude-codex-lf-1
title the bogwise eel-trapping smith
fits stage=adult|old
prefers role=merchant job=smith
traits temper=even talk=chatty warmth=reserved humour=dry honesty=plain piety=ordinary drive=steady
quirk can_find_a_path_across_any_bog
likes mutton_stew whittling tidy_house first_warm_day
dislikes stale_bread bad_manners
fears a_hot_shoe_cracking_under_the_hammer a_trap_lost_in_a_river_flood
hopes a_sound_anvil_for_every_order a_first_warm_day_by_the_river
topics work +0.5 pastimes +0.4 travel +0.3 food +0.2
styles comfort=practical gossip=wry refuse=plain tease=dry
marks oath saying
persona #self.first# runs the #forge#, finds a #path# across any #bog#, and claims the best #eel# #traps# on the #river#.

words
oath! = Anvil and river | By the sound shoe
saying! = Heat it evenly before you strike | A good trap waits where the water turns
smithy = smithy | village smithy
forge = forge | smithy forge
anvil = anvil | iron anvil
hammer = hammer | smith hammer
hammers = hammers | work hammers
strike = strike | measured strike
strikes = strikes | even strikes
blow = blow | hammer blow
blows = blows | steady blows
iron = iron | hot iron
bar = bar | heated bar
bars = bars | iron bars
tongs = tongs | long tongs
bellows = bellows | forge bellows
coal = coal | forge coal
coals = coals | banked coals
fire = fire | forge fire
heat = heat | even heat
spark = spark | bright spark
sparks = sparks | bright sparks
ash = ash | cold ash
steam = steam | quench steam
quench = quench | water quench
bucket = bucket | water bucket
water = water | clear water
shoe = shoe | horse shoe
shoes = shoes | fitted shoes
nail = nail | iron nail
nails = nails | small nails
hinge = hinge | door hinge
hinges = hinges | door hinges
blade = blade | iron blade
edge = edge | clean edge
tool = tool | farm tool
tools = tools | farm tools
order = order | smithy order
orders = orders | written orders
book = book | order book
price = price | posted price
prices = prices | posted prices
cost = cost | iron cost
coin = coin | earned coin
merchant = merchant | travelling merchant
buyer = buyer | local buyer
customer = customer | waiting customer
customers = customers | local customers
counter = counter | shop counter
shelf = shelf | tool shelf
stock = stock | smithy stock
hand = hand | working hand
hands = hands | smithy hands
