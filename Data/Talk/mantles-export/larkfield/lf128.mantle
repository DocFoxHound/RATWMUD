master = master | village master
lesson = lesson | forge lesson
work = work | smithy work
bench = bench | work bench
floor = floor | swept floor
roof = roof | sound roof
label = label | paper label
shop = shop | small shop
nightfall = nightfall | late nightfall
field = field | open field
marks = marks | worn marks
sack = sack | coal sack
scale = scale | shop scale
wheel = wheel | cart wheel
bridge = bridge | stone bridge
step = step | careful step
handle = handle | tool handle
stairs = stairs | upstairs steps
flat = flat | upstairs flat
door = door | front door
window = window | small window
home = home | tidy home
house = house | small house
mutton = mutton | stew mutton
stew = stew | mutton stew
pot = pot | stew pot
plate = plate | supper plate
bread = bread | day bread
loaf = loaf | stale loaf
knife = knife | small knife
wood = wood | whittling wood
shaving = shaving | wood shaving
shavings = shavings | wood shavings
