# The realm's common speech (Docs/Design/62-talk.md, section 3): the bottom layer of every speaker's grammar, and
# Ridgemere's own. Every symbol a rule or a dialect uses must be here, so any dialect can leave a word out and fall
# back to ordinary speech.
#
#   symbol = words | words              one of them, at random
#   symbol[facts] = words               only where the facts hold; the most specific entry that holds wins
#   symbol! = words | words             a habit: chosen once per person, for good
#   symbol!! = words | words            a habit for each one they speak to (a fond name for each friend)
#   symbol.broad = words                (in a dialect) said only by the broadest accents
#   words^m | words^f                   for one sex of the one spoken to
#
# Each symbol is one kind of word, so it fits wherever it is used: cold, hot, tired, drunk, good, bad, very are
# words like "cold" ("it's #very# #cold#"); rain, money, luck, nonsense, child, home are things ("this #rain#"); greet,
# farewell, thanks, agree, refuse, surprise, annoyed, oath are whole sayings; tag ends a sentence (", eh").
#
# A speaker's dialect (the grammar named for where they grew up) is used as their accent says: none, never; light,
# half the time; broad, always, with its .broad words. Drafts (phase 3), to be written properly with you (phase 7).

grammar plain
greet = Good day | Hello | Morning
greet[here.time=dawn] = Morning | Good morning
greet[here.time=dusk|night] = Evening | Good evening
farewell = Farewell | Good day to you | Mind how you go
thanks = Thank you | Thanks | Much obliged
agree = Aye | True enough | That it is
refuse = No | Not likely | I'd rather not
surprise = Well! | Is that so | You don't say
annoyed = Bother | Curse it | Of all the luck
very = very | right | terribly
little = a little | a bit | a touch
good = fine | good | sound
bad = poor | bad | sorry
worthless = worthless | no use | rubbish
luck = luck | good fortune | a stroke of luck
child = child | pup
address = friend | neighbour
address[other.stage=young] = little one | lad^m | lass^f
pet!! = my dear | love | old friend
money = coin | money | pennies
cold = cold | bitter | raw
hot = hot | close | stifling
rain = rain | wet | downpour
tired = tired | worn out | weary
drunk = drunk | merry | tipsy
nonsense = nonsense | rubbish | foolishness
tag = , isn't it | , eh | , wouldn't you say
oath! = Gods | Heavens | Blood and bread | Well, I never
robbery = Robbery, plain and simple | Daylight robbery | A crime, that is
home = home | my own fire
hungry = hungry | starved | empty as a drum
hurt = sore | stiff | aching
work = work | the work | graft
bed = bed | my bed | a pillow
# For each person's own words (their character table, doc 62 phase 6): a saying of their own, and what they call
# their spouse. Plain's are the ordinary ones; a person's own layer gives theirs.
saying! = Well, there it is | That's how it goes | So it goes | Such is life
dear! = love | dear | my heart

# The router's openers (phase 5): what a resident says before an answer, by tone. ~ is nothing at all.
opener = ~ | ~ | Well,
opener[self.tone=warm] = Of course! | Happy to help. | Ah, let me think.
opener[self.tone=gruff] = ~ | Hmph. | Listen.
opener[self.tone=formal] = Certainly. | Of course. | Allow me.
opener[self.tone=sly] = For you? | Ah, well now. | Since you ask,
opener[self.tone=shy] = Oh, um. | I, well. | Oh!

# Phase 7's words (the conversations written for the main factors and the everyday topics). Each is one kind of word:
# things take their article where shown ("#watch# took them", "in #gaol#", "after #supper#"); a person without one
# ("a #thief#", "a #stranger#"); words like "busy" or "poorly" fit where "cold" does ("you look #poorly#"); whole
# sayings stand alone (#toast#, #blessing#, #bless#).
# Work and trade.
wages = wages | pay | pennies
boss = the master | the boss | the old wolf
busy = busy | rushed | run ragged
slow = slow | quiet | dead
takings = takings | the till | the day's money
cheated = cheated | robbed blind | done
# Family: what one calls their mother and father (habits: always the same), grandparents, the evening meal.
mum! = Mum | Mam | Mother | Ma
dad! = Dad | Da | Father | Pa
gran = Gran | Granny | Nan | Grandmother
grandad = Grandad | Gramps | Grandfather | Grandda
supper = supper | dinner | tea
# Town and class: the rich as the rest see them, the poor as the rich see them, out of money, grand, a tattler, a
# polite word to one's betters.
toffs = the toffs | the nobs | the quality | the fine folk
rabble = the rabble | the riff-raff | that lot | the gutter crowd
skint = skint | broke | cleaned out | short
posh = posh | grand | fancy | la-di-da
busybody = busybody | nosy parker | gossip | tattler
sir = sir^m | madam^f
# Friends and rivals: a rival to their face, a friend teased, mad, a toast, a drink to stand someone, a fool.
insult = you mangy cur | you lout | you sour old stick | you flea-bitten so-and-so
fool = you daft lump | you great fool | you muttonhead | you soft article
daft = daft | soft in the head | cracked | barmy
toast = Your health | Here's to us | Fur and fortune | Down the hatch
drink = a jar | a drink | a pint | a cup of cider | a drop of something
lump = great lump | oaf | lummox | daft article
later = later | by and by | another time
# The moment.
fog = fog | mist | murk
snow = snow | white stuff
mud = mud | muck | mire
wind = wind | gale | blow
ale = ale | beer | brown ale
# Hard times: the law and the want.
watch = the Watch | the watch
thief = thief | cutpurse | light-pawed sort
bandits = bandits | robbers | road wolves
gaol = the gaol | the cells | the lock-up
dole = the dole | the parish bread | the parish loaf
grave = the ground | the grave | the churchyard
# Food and the house.
grub = food | grub | victuals
tasty = tasty | toothsome | lovely
mess = mess | state | tip
snug = snug | cosy | warm
# Pastimes and beasts.
beasts = the beasts | the stock | the animals
bet = a wager | a bet | a flutter
# Health and the past.
poorly = poorly | under the weather | off colour | out of sorts
chill = a chill | a cold | the sniffles
remedy = willow bark | a mustard poultice | goose grease | honey and onion | a nettle brew | a hot brick in a cloth
olddays = the old days | days gone by | the good old days
# Blessings, and someday.
blessing = The Bright One keep you | Bless you | Blessings on you | Bright One watch over you
bless = Gods keep you | Bright One bless you | The gods go with you
someday = someday | one day | one fine day
# Travel.
far = a long way | a fair step | miles off
stranger = stranger | outsider | newcomer
journey = journey | trek | long haul
