# Coldwater (Docs/Design/62-talk.md, section 3): the lake's fishers on Glasswater, where the Long River rises. Calm;
# nets, water, weed and catch. Drafts (phase 3), to be written properly with you (phase 7).

grammar coldwater
greet = Still water | Calm water to you
greet.broad = Still water, still water
farewell = Fair winds | Calm water
agree = It'll float | Fair enough
refuse = That won't float
surprise = Well, I'll be netted | Calm, now
annoyed = Weed and tangle | Holed again
very = right
good = fair catch | fair
bad = muddied | rough
worthless = bait | net-weed
luck = a full net
child = minnow
pet!! = little fish | my pearl
rain = lake-rain | wet
tired = waterlogged
nonsense = weed
tag = , eh?
oath! = Deep and dark | Net and line | Glass and gods
home = my own shore
# (Phase 7, the rest of plain's words.)
address = neighbour | shore-friend
address[other.stage=young] = minnow | little fish
bed = my hammock | the bunk
cold = lake-cold | chill
dear! = my pearl | my catch | love
drunk = half-sunk | afloat
hot = sticky | close
hungry = empty as a holed net | hungry
hurt = sore | knocked about
little = a drop | a ripple
money = scale-coin | coin
robbery = Netted, plain as day | That's poaching, that is
saying! = Water finds its level | Still water, deep water | The lake takes what it takes
thanks = Thank you kindly | Thanks, friend
work = the nets | the catch | the work
# (Phase 7, the conversations' words.)
wages = scale-coin | pay
boss = the skipper | the net-master
busy = run off my paws | hauling all day
slow = becalmed | dead water
takings = the catch | the day's catch
cheated = netted | gutted
mum! = Mam | Ma
dad! = Da | Pa
gran = Granny | Gran
grandad = Grandad | Old Da
supper = supper | the pot
toffs = the dry-pawed lot | the quality
skint = cleaned out | holed
busybody = net-mender | gossip
fool = you great herring | you wet lump
daft = water-headed | daft
toast = Calm water | Full nets | Fair winds
drink = a jar | a dram
fog = lake-mist | the grey
wind = a blow off the lake | wind
watch = the Watch
thief = net-robber | thief
grave = the deep | the ground
grub = fish | grub
poorly = waterlogged | poorly
chill = the lake-cold | a chill
remedy = fish oil | a hot stone | willow bark
olddays = the old water | days gone by
blessing = Calm water to you | Fair winds | The lake keep you
bless = Calm water | The lake keep you
far = across the water | a long row
stranger = shore-stranger | outsider
journey = voyage | long row
