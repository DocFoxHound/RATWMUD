# Larkfield (Docs/Design/62-talk.md, section 3): the market town of the Larkdowns. Quick, a trader's speech; prices,
# weights and bargains. Drafts (phase 3), to be written properly with you (phase 7).

grammar larkfield
greet = Fair price to you | Good trade
greet.broad = Fair price, fair price
farewell = Good trading | Fair price
agree = Sold | Done
refuse = No sale | Not at that price
surprise = Well, sell me | There's a bargain
annoyed = Short-changed again | Scales and spite
very = top-weight
little = a lark's worth
good = fair-priced | full weight
bad = short-weighed | light
worthless = haggle-bait
luck = a bargain
child = lambkin
pet!! = my bargain | my lark
money = silver
nonsense = market talk
tag = , eh?
oath! = Scales and silver | By the market cross | Weights and measures
# (Phase 7, the rest of plain's words.)
address = friend | customer
address[other.stage=young] = lambkin | young 'un
bed = my bed | a straw sack
cold = raw | nippy
dear! = my lamb | my bargain | my love
drunk = market-merry | in their cups
home = home | my own hearth
hot = sweltering | close
hungry = peckish | starving
hurt = sore | knocked
rain = drizzle | downland rain
robbery = Short-weight robbery | Daylight robbery, and no change given
saying! = Everything has its price | It all comes out in the weighing | Buy cheap, sell dear
thanks = Much obliged | Ta
tired = worn thin | done in
work = trade | the stall | the work
# (Phase 7, the conversations' words.)
wages = pay | silver
boss = the master | the gaffer
busy = run ragged | trading flat out
slow = no trade | dead
takings = the till | the day's silver
cheated = short-weighed | diddled | done
mum! = Mum | Mam
dad! = Dad | Pa
gran = Nan | Granny
grandad = Grandad | Gramps
supper = tea | supper
toffs = the nobs | the quality
rabble = the rabble | that lot
skint = skint | out of silver
posh = posh | top-shelf
busybody = market-mouth | nosy parker
fool = you muttonhead | you great lamb
daft = daft | soft
toast = Good trade | Full weight | Here's to profit
drink = a pint | a jar
mud = muck | downland mud
ale = market ale | ale
thief = cutpurse | thief
gaol = the lock-up
dole = the parish loaf
grub = grub | vittles
tasty = lovely | top-weight
beasts = the flock | the stock
bet = a flutter | a wager
poorly = off colour | poorly
olddays = the old days | when wool was dear
blessing = Good trading to you | Bless you
far = a fair step | three days' drove
stranger = incomer | outsider
journey = drove | journey
