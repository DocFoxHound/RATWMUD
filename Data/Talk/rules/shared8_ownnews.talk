rule s83w_crime_hurt_old
when concept=talk.news topic.kind=crime self.injured=light|bad self.stage=old
does tell.feeling
cooldown 1d
say #topic.news#. At my age, the bones don't mend. | #topic.news#. I'm too old to be knocked about. | #topic.news#. Look at my arm.

