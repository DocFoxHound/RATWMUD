# How a resident feels about a player, in what they say to them (Docs/Design/62-talk.md, phase 7; "Players, as
# settled"): their disposition (hostile, wary, cool, neutral, warm, fond: from what the two have been through), a long
# absence, and how the resident is today (grieving, hurt). These concepts always take their best tier: hostility always
# shows (priority 3); fondness and wariness join the tone's own lines (the same score), so they come up often but not
# always; a resident's grief or hurt likewise.
#
# Never #other.name# here: a resident knows a player only by a name they were given (#topic.player#, doc 32).

## Greetings

rule rg_greet_hostile
when concept=player.greet pair.disposition=hostile
priority 3
say You. | I've nothing to say to you. | Keep walking. | What do you want?

rule rg_greet_hostile_named
when concept=player.greet pair.disposition=hostile topic.meeting=known|returning
priority 3
say #topic.player#. You've a nerve. | Oh, it's you, #topic.player#. Wonderful. | I know you, #topic.player#. Don't think I don't.

rule rg_greet_wary
when concept=player.greet pair.disposition=wary topic.meeting=known|returning
priority 1
say Oh. It's you. | What is it this time, #topic.player#? | #topic.player#. Hm. What do you want?

rule rg_greet_cool
when concept=player.greet pair.disposition=cool topic.meeting=known|returning
priority 1
say #topic.player#. | Aye, #topic.player#? | Back again.

rule rg_greet_warm
when concept=player.greet pair.disposition=warm topic.meeting=known|returning
priority 1
say #topic.player#! Good to see you. | Ah, #topic.player#. Come in, come in. | Well met, #topic.player#.

rule rg_greet_fond
when concept=player.greet pair.disposition=fond topic.meeting=known|returning
priority 1
say #topic.player#! There you are! | Oh, it's good to see you, #topic.player#. | My favourite face! #greet#, #topic.player#! | #topic.player#, #pet#! Come here.

rule rg_greet_long_gone
when concept=player.greet topic.meeting=returning pair.days_since>=28
priority 1
say #topic.player#! I thought you'd gone for good. | Where've you been all this while? It's been since #topic.since#! | Look what the wind blew in. It's been an age.

rule rg_greet_fond_long_gone
when concept=player.greet topic.meeting=returning pair.days_since>=28 pair.disposition=fond|warm
priority 1
say #topic.player#! I'd given you up! Where have you been? | Gods, #topic.player#! Not a word since #topic.since#! Come here. | You're back! I was sure something had happened to you.

rule rg_greet_mourning
when concept=player.greet mourning=kin
priority 2
say Oh. Hello. Forgive me, I'm not myself. | #greet#. It's been a hard week. | Hello. Sorry. We've had a death.

rule rg_greet_hurt
when concept=player.greet injured=bad
priority 2
say Mind, don't jostle me. I'm hurt. | #greet#. Excuse me if I don't get up. | Ah. Hello. Gently, now.

rule rg_greet_robbed
when concept=player.greet robbed=yes
priority 2
say Hello. Watch your purse; I've been robbed. | Did you see anyone running? They robbed me! | #greet#. Sorry. Someone's had my things.

## Thanks, and goodbye

rule rg_thanks_hostile
when concept=player.thanks pair.disposition=hostile
priority 3
say Hmph. | Don't thank me. Just go. | Aye. Now leave me be.

rule rg_thanks_fond
when concept=player.thanks pair.disposition=fond
priority 1
say For you? Any time. | Oh, hush. You'd do the same for me. | Anything, #topic.player#.

rule rg_bye_hostile
when concept=player.bye pair.disposition=hostile
priority 3
say Good riddance. | Don't come back. | Finally.

rule rg_bye_wary
when concept=player.bye pair.disposition=wary
priority 1
say Mm. | Aye, go on. | Off you go, then.

rule rg_bye_fond
when concept=player.bye pair.disposition=fond topic.meeting=known|returning
priority 1
say Don't be a stranger, #topic.player#. | Come back soon, #pet#. | Safe roads, #topic.player#. Mind you come back.

## What they're asked: the answer, but grudgingly (or gladly)

rule rg_answer_hostile
when concept=player.trade|player.hours|player.job|player.where|player.wanted|player.day pair.disposition=hostile
priority 3
say If you must know: #topic.answer# | #topic.answer# Now go. | Fine. #topic.answer#

rule rg_answer_wary
when concept=player.trade|player.hours|player.job|player.where|player.wanted|player.day pair.disposition=wary
priority 1
say Why do you ask? ... #topic.answer# | Hm. #topic.answer# | #topic.answer# That's all I know.

rule rg_answer_fond
when concept=player.trade|player.hours|player.job|player.where|player.wanted|player.day pair.disposition=fond
priority 1
say For you? #topic.answer# | Anything for you. #topic.answer# | Oh, easy. #topic.answer#
