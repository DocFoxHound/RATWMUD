## The other's last word (friend.parting; self: the second speaker again; pair.mem.fp: light, funeral, blessing)

rule x7_fp_any
when concept=friend.parting pair.mem.fp=light
say Go on, then. | #later.capitalize#, #pet#. | Mind how you go. | Off you pop.

rule x7_fp_any2
when concept=friend.parting pair.mem.fp=light
say Aye, aye. | Ha! Get on. | See you, then.

rule x7_fp_warm
when concept=friend.parting pair.mem.fp=light self.warmth=warm
say Look after yourself, #pet#! | Come by soon, mind! | #bless.capitalize#.

rule x7_fp_devout
when concept=friend.parting pair.mem.fp=light self.piety=devout
say #bless.capitalize#. | Bright One keep you. | Go in peace.

rule x7_fp_cold
when concept=friend.parting pair.mem.fp=light self.warmth=cold
say Mm. | Right. | Hm.

rule x7_fp_working
when concept=friend.parting pair.mem.fp=light self.working=yes
say Aye, back to it. | Can't stop. #later.capitalize#! | Work calls.

rule x7_fp_young
when concept=friend.parting pair.mem.fp=light self.stage=young
say Bye! | Bye bye! | See you!

rule x7_fp_merry
when concept=friend.parting pair.mem.fp=light self.humour=merry
say Ha! Mind you don't trip over your tail! | Off you go, trouble! | Ha! Go on, then, go on!

rule x7_fp_funeral
when concept=friend.parting pair.mem.fp=funeral
priority 2
say Gods keep them. | Go gently, #pet#. | I'll be thinking of you all.

rule x7_fp_funeral_devout
when concept=friend.parting pair.mem.fp=funeral self.piety=devout
priority 2
say Go with the Bright One's peace. | I'll light a candle for them. | #blessing#.

rule x7_fp_blessing
when concept=friend.parting pair.mem.fp=blessing
priority 2
say And to you, #pet#. | Bright One keep you. | Go in peace.
