then other: family.settle

rule f7_ap_goodbye
when concept=family.answer_parent conv.f7_pc=goodbye
does answer.detail
priority 1
say {f7_tone=sweet} Bye! Bring me something! | {f7_tone=sweet} I'll be good. Mostly. | {f7_tone=sweet} Can I come? | {f7_tone=sweet} Bye! Don't be long!
then other: family.settle

rule f7_ap_play
when concept=family.answer_parent conv.f7_pc=play
does answer.detail
priority 1
