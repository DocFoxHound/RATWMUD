        {
          "id": "thaw",
          "kind": "clock",
          "day": 90,
          "actor": ""
        }
      ],
      "expect": [
        "enrol",
        "ferry-watch",
        "deep-freeze",
        "ferries-reopen"
      ],
      "expectEffects": [
        {
          "phase": "deep-freeze",
