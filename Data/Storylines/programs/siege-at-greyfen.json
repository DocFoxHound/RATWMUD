        {
          "kind": "npc.walk",
          "npc": "harrow",
          "cell": "barracks",
          "x": 22,
          "y": 4,
          "pace": "walk",
          "cue": "at-throne"
        }
      ],
      "exits": [],
      "triggers": [
        {
          "id": "take-seat",
