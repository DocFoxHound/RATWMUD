          "match": {
            "actor": "tamsin",
            "detail": "right-post"
          },
          "actions": [
            {
              "do": "add",
              "scope": "story",
              "key": "guard-posts",
              "value": 1
            },
            {
              "do": "emit",
              "signal": "check-posts"
            }
          ],
          "once": "visit"
        },
        {
          "id": "open-relief",
          "on": "story signal",
          "signal": "check-posts",
          "if": {
            "test": "counter",
            "scope": "story",
            "key": "guard-posts",
            "op": ">=",
            "value": 2
          },
          "actions": [
            {
              "do": "enter",
              "phase": "relief"
            }
          ]
        },
        {
          "id": "send-reserves",
          "on": "scene blocked",
          "actions": [
            {
              "do": "enter",
              "phase": "reserves"
            }
          ]
        }
      ]
    },
    {
      "id": "relief",
      "journal": "Birch and Tamsin have crossed the breach. Open the relief route. Speak with Wren about stock for the road and report the watch strength to Harrow. The work can be shared.",
      "effects": [],
      "exits": [
        {
          "on": "missions completed",
          "missions": [
            "stores",
            "roll-call"
          ],
          "to": "secured"
        }
      ],
      "missions": [
        {
          "id": "stores",
          "title": "Provision the relief watch",
          "mode": "either",
          "objectives": [
            {
              "label": "Ask Wren to set aside supplies for the watch.",
              "on": "conversation",
              "match": {
                "target": "wren"
              }
            }
          ]
        },
        {
          "id": "roll-call",
          "title": "Account for the defenders",
          "mode": "either",
          "objectives": [
            {
              "label": "Give Harrow the names of those who held the breach.",
              "on": "conversation",
              "match": {
                "target": "harrow"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "secured",
      "journal": "The relief route is open. The watch has its supplies and every name is accounted for.",
      "effects": [],
      "exits": []
    },
    {
      "id": "reserves",
