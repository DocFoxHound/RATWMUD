          "match": {
            "actor": "harrow",
            "detail": "at-throne"
          },
          "actions": [
            {
              "do": "effect",
              "effect": {
                "kind": "npc.pose",
                "npc": "harrow",
                "posture": "sitting",
                "cue": "seated"
              }
            }
          ]
        },
        {
          "id": "collect-report",
          "on": "scene posed",
          "match": {
            "actor": "harrow",
            "detail": "seated"
          },
          "actions": [
            {
              "do": "effect",
              "effect": {
                "kind": "npc.walk",
                "npc": "sloe",
                "cell": "town",
                "x": 30,
                "y": 36,
                "pace": "run",
