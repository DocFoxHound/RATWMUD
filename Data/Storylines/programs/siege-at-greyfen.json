          "actions": [
            {
              "do": "effect",
              "effect": {
                "kind": "npc.speak",
                "npc": "harrow",
                "text": "Birch, take the left side. Tamsin, the right. Through the breach together. We bring every defender home.",
                "cue": "orders-given"
              }
            }
          ]
        },
        {
          "id": "send-guards",
          "on": "scene spoken",
          "match": {
            "actor": "harrow",
            "detail": "orders-given"
          },
          "actions": [
            {
              "do": "effect",
              "effect": {
                "kind": "npc.walk",
                "npc": "birch",
                "cell": "town",
                "x": 30,
                "y": 37,
                "pace": "run",
                "cue": "left-post"
              }
            },
            {
              "do": "effect",
              "effect": {
                "kind": "npc.walk",
                "npc": "tamsin",
                "cell": "town",
                "x": 33,
                "y": 37,
                "pace": "run",
                "cue": "right-post"
