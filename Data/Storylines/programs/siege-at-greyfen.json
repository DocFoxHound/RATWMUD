{
  "format": "ratw-story-program",
  "version": 1,
  "id": "siege-at-greyfen",
  "title": "The breach at Greyfen",
  "start": "hold",
  "audience": {
    "kind": "active",
    "days": 7
  },
  "regions": [
    {
      "id": "breach",
      "cell": "town",
      "x1": 29,
      "y1": 34,
      "x2": 34,
      "y2": 38
    }
  ],
  "phases": [
    {
      "id": "hold",
      "journal": "Defend the gap on Greyfen’s south road. Three bandits must fall inside the breach. Each defender earns personal credit for the foes they bring down.",
      "effects": [
        {
          "kind": "story.area.spawn",
          "region": "breach",
          "count": 3
        }
      ],
      "exits": [],
      "triggers": [
        {
          "id": "count-defeat",
          "on": "bandit falls",
          "audience": "participant",
          "if": {
            "test": "region",
            "region": "breach"
          },
          "actions": [
            {
              "do": "add",
              "scope": "player",
              "key": "defeats",
              "value": 1
            },
            {
              "do": "add",
              "scope": "story",
              "key": "line-held",
              "value": 1
            },
            {
              "do": "emit",
              "signal": "check-breach"
            }
          ]
        },
        {
          "id": "dispatch-runner",
          "on": "story signal",
          "signal": "check-breach",
          "if": {
            "test": "counter",
            "scope": "story",
            "key": "line-held",
            "op": ">=",
            "value": 3
          },
          "actions": [
            {
              "do": "enter",
              "phase": "council"
            }
          ]
        }
      ]
    },
    {
      "id": "council",
      "journal": "Sloe carries the count from the breach to the barracks. Harrow takes the king’s part at the watch table. Wait for his orders and for both guards to reach the south road.",
