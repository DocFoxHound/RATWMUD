                "kind": "npc.walk",
                "npc": "sloe",
                "cell": "barracks",
                "x": 21,
                "y": 4,
                "pace": "run",
                "cue": "at-court"
              }
            }
          ]
        },
        {
          "id": "give-report",
          "on": "scene arrived",
          "match": {
            "actor": "sloe",
            "detail": "at-court"
          },
          "actions": [
            {
              "do": "effect",
              "effect": {
                "kind": "npc.speak",
                "npc": "sloe",
                "text": "Three down at the breach. The line holds, but the south road is still open.",
                "cue": "report-heard"
              }
            }
          ]
        },
        {
          "id": "king-rises",
          "on": "scene spoken",
          "match": {
            "actor": "sloe",
            "detail": "report-heard"
