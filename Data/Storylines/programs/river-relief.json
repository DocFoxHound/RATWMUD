{
  "format": "ratw-story-program",
  "version": 1,
  "id": "river-relief",
  "title": "When the ferries stop",
  "audience": {
    "kind": "active",
    "days": 7
  },
  "start": "survey",
  "phases": [
    {
      "id": "survey",
      "journal": "The ferry is tied up. Two jobs come first: learn who is stranded and get word upriver. Anyone with time can copy the passenger list.",
      "missions": [
        {
          "id": "passengers",
          "title": "Account for the passengers",
          "mode": "individual",
          "objectives": [
            {
              "label": "Ask the carter how many passengers missed the crossing.",
              "on": "conversation",
              "match": {
                "target": "rm111"
              }
            },
            {
              "label": "Report the number to the innkeeper.",
              "on": "conversation",
              "match": {
                "target": "rm112"
              }
            }
          ],
          "percent": 60
        },
        {
          "id": "dispatch",
          "title": "Send word upriver",
          "mode": "either",
          "objectives": [
            {
              "label": "Send two letters asking the upstream landings to hold their boats.",
              "on": "letter sent",
              "goal": 2
            }
          ]
        },
        {
          "id": "manifest",
          "title": "Copy the passenger list",
          "mode": "individual",
          "objectives": [
            {
              "label": "Copy the stranded passengers’ names at the archive.",
              "on": "archive work",
              "match": {
                "item": "copy"
              }
            }
          ]
        }
      ],
      "effects": [
        {
          "kind": "npc.line",
          "npc": "rm111",
          "text": "The rope parted in the night. Count those waiting before we promise a place."
        }
      ],
      "exits": [
        {
          "on": "missions completed",
          "missions": [
            "passengers",
            "dispatch"
          ],
          "to": "rigging"
        }
      ]
    },
    {
      "id": "rigging",
      "journal": "The upstream landings are waiting. Get a line across the river and buy supplies for the ferries. Volunteers can also tend the injured.",
      "missions": [
        {
          "id": "ferry-line",
          "title": "Rig a new ferry line",
          "mode": "group",
          "objectives": [
            {
              "label": "Bring the carter four coils of rope between you.",
              "on": "gift",
              "match": {
                "target": "rm111",
                "item": "rope"
              },
              "goal": 4,
              "measure": "quantity"
            },
            {
              "label": "Deliver two lengths of canvas to the carter for the landing shelter.",
              "on": "gift",
              "match": {
                "target": "rm111",
                "item": "canvas"
              },
              "goal": 2,
              "measure": "quantity"
            }
          ]
        },
        {
          "id": "provisions",
          "title": "Buy provisions for the crossing",
          "mode": "either",
          "objectives": [
            {
              "label": "Buy four units of supplies at market stalls.",
              "on": "stall sale",
              "goal": 4,
              "measure": "quantity"
            }
          ]
        },
        {
          "id": "first-aid",
          "title": "Tend the landing crew",
          "mode": "individual",
          "objectives": [
            {
              "label": "Tend an injured wolf.",
              "on": "tended"
            }
          ]
        }
      ],
      "effects": [],
      "exits": [
        {
          "on": "missions completed",
          "missions": [
            "ferry-line",
            "provisions"
          ],
          "to": "accounts"
        }
      ]
    },
    {
      "id": "accounts",
      "journal": "The ferry is carrying passengers again. Return the borrowed kit and file a public account of the closure. The crew would welcome a meal.",
      "missions": [
        {
          "id": "borrowed-kit",
          "title": "Return the borrowed kit",
          "mode": "individual",
          "objectives": [
            {
              "label": "Return a loan to its owner.",
              "on": "loan returned"
            }
          ]
        },
        {
          "id": "public-account",
          "title": "File the public account",
          "mode": "either",
          "objectives": [
            {
              "label": "Copy the relief account at the archive.",
              "on": "archive work",
              "match": {
                "item": "copy"
              }
            },
            {
              "label": "Post a public notice with the final account.",
              "on": "notice posted"
            }
          ]
        },
        {
          "id": "crew-meal",
          "title": "Share supper with the crew",
          "mode": "individual",
          "objectives": [
            {
              "label": "Share a meal with another wolf.",
              "on": "shared meal"
            }
          ]
        }
      ],
      "effects": [],
      "exits": [
        {
          "on": "missions completed",
          "missions": [
            "borrowed-kit",
            "public-account"
          ],
          "to": "reopened"
        }
      ]
    },
    {
      "id": "reopened",
      "journal": "The new ferry line holds. The account is posted and the borrowed kit is home.",
      "effects": [],
      "exits": []
    }
  ],
