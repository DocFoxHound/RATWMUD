{
  "about": "The roleplay profile on the player card, statuses, experience and handles (Docs/Design/50-player-card-friends-safety.md, sections 1 to 3). Every number is a placeholder.",
  "limits": {"description": 1200, "currently": 120, "pronouns": 24, "title": 40, "motto": 120, "oocNotes": 300, "history": 3000,
             "glances": 5, "glanceTitle": 32, "glanceLine": 120, "otherLimits": 200, "residentDescription": 300},
  "glanceIcons": ["scar", "eye", "nose", "ear", "paw", "fang", "coat", "collar", "tail", "heart", "star", "smoke", "flower", "bone", "feather", "moon", "drop", "flame"],
  "senses": {"sight": {"name": "Seen"}, "scent": {"name": "Smelt", "reach": 3}, "sound": {"name": "Heard", "reach": 15}},
  "sliders": [["Chaotic", "Lawful"], ["Chaste", "Lustful"], ["Forgiving", "Vindictive"], ["Altruistic", "Selfish"], ["Truthful", "Deceitful"],
              ["Gentle", "Brutal"], ["Superstitious", "Rational"], ["Renegade", "Paragon"], ["Cautious", "Impulsive"], ["Ascetic", "Bon vivant"],
              ["Valorous", "Spineless"]],
  "consent": [{"id": "injury", "name": "Character injury"}, {"id": "death", "name": "Character death"}, {"id": "romance", "name": "Romance"},
              {"id": "crime", "name": "Criminal activity"}, {"id": "control", "name": "Loss of control"}],
  "consentAnswers": {"yes": "Yes", "no": "No", "ask": "Ask me first"},
  "statuses": [{"id": "ic", "name": "In character"},
               {"id": "ooc", "name": "Out of character", "mark": "ooc"},
               {"id": "lfs", "name": "Looking for a scene", "mark": "lfs"},
               {"id": "storyteller", "name": "Storyteller", "mark": "quill", "approvedOnly": true}],
  "experience": [{"id": "newcomer", "name": "Newcomer"}, {"id": "casual", "name": "Casual"}, {"id": "experienced", "name": "Experienced"},
                 {"id": "guide", "name": "Newcomer Guide"}],
  "defaultExperience": "casual",
  "pronouns": ["she/her", "he/him", "they/them"],
  "handle": {"min": 3, "max": 24, "changeDays": 30},
  "played": {"every": 60, "activeWithin": 300},
  "friends": {"most": 200, "requestsWaiting": 20, "requestDays": 14, "shareByDefault": true},
  "privateMessages": {"most": 2000, "inbox": 50, "inboxDays": 14},
  "known": {"players": 300, "residents": 100, "metEvery": 600, "note": 500, "customTag": 24,
            "tags": [{"id": "unfriendly", "name": "Unfriendly"}, {"id": "neutral", "name": "Neutral"}, {"id": "business", "name": "Business"},
                     {"id": "friendly", "name": "Friendly"}, {"id": "love", "name": "Love"}, {"id": "family", "name": "Family"}]},
  "recaps": {"perWolf": 3, "perCharacter": 150, "bufferLines": 120, "bufferCharacters": 6000, "modelLines": 6, "modelMinutes": 5,
             "modelADay": 10, "most": 600},
  "circles": {"name": 32, "perAccount": 10, "members": 50, "nights": 10, "nightPlace": 80, "nightLine": 160, "inviteDays": 14,
              "shareByDefault": false}
}
