{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Run Against the World",
  "version": "0.0.1",
  "identifier": "net.ratw.client",
  "build": {
    "frontendDist": "../page"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Run Against the World (spike)",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
